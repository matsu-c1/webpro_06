<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.title %></title>
</head>
<body>
  <h2><%= data.title %> の詳細</h2>

  <table>
    <tr><th>項目</th><th>内容</th></tr>
    <tr><td>担当教員</td><td><%= data.teacher %></td></tr>
    <tr><td>曜日・時限</td><td><%= data.day %></td></tr>
    <tr><td>教室</td><td><%= data.room %></td></tr>
    <tr><td>単位数</td><td><%= data.credit %></td></tr>
  </table>

  <a href="/lecture/edit/<%= id %>">編集</a>
  <a href="/lecture">一覧に戻る</a>
</body>
</html>
