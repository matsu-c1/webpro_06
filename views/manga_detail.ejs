<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.title %></title>
</head>
<body>
  <h2><%= data.title %> の詳細</h2>

  <table>
    <tr><th>項目</th><th>内容</th></tr>
    <tr><td>作者</td><td><%= data.author %></td></tr>
    <tr><td>掲載誌</td><td><%= data.magazine %></td></tr>
    <tr><td>ジャンル</td><td><%= data.genre %></td></tr>
  </table>

  <a href="/manga/edit/<%= id %>">編集</a>
  <a href="/manga">一覧に戻る</a>
</body>
</html>