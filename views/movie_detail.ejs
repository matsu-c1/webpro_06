<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.title %></title>
</head>
<body>
  <h2><%= data.title %> の詳細</h2>

  <table>
    <tr><th>項目</th><th>内容</th></tr>
    <tr><td>監督</td><td><%= data.director %></td></tr>
    <tr><td>ジャンル</td><td><%= data.genre %></td></tr>
    <tr><td>公開年</td><td><%= data.year %></td></tr>
    <tr><td>上映時間</td><td><%= data.length %> 分</td></tr>
  </table>

  <a href="/movie/edit/<%= id %>">編集</a>
  <a href="/movie">一覧に戻る</a>
</body>
</html>
