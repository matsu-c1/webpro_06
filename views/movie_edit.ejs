<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.title %></title>
</head>
<body>
  <h2><%= data.title %> の編集</h2>

  <form action="/movie/update/<%= data.id - 1 %>" method="POST">
    <table>
      <tr>
        <th>項目</th>
        <th>データ</th>
      </tr>
      <tr>
        <td>タイトル</td>
        <td><input type="text" name="title" value="<%= data.title %>"></td>
      </tr>
      <tr>
        <td>監督</td>
        <td><input type="text" name="director" value="<%= data.director %>"></td>
      </tr>
      <tr>
        <td>ジャンル</td>
        <td><input type="text" name="genre" value="<%= data.genre %>"></td>
      </tr>
      <tr>
        <td>公開年</td>
        <td><input type="text" name="year" value="<%= data.year %>"></td>
      </tr>
    </table>

    <input type="submit" value="更新">
  </form>

  <hr>

  <a href="/movie/delete/<%= data.id - 1 %>"
     onclick="return confirm('本当に削除しますか？');">
    削除
  </a>

  <br><br>
  <a href="/movie">一覧に戻る</a>
</body>
</html>
